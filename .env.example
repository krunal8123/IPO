# IPORadar Environment Configuration Template
# Web Push VAPID Keys (Generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@iporadar.app

# Server Port
PORT=5001

# Upstox API Credentials (Optional)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5001/api/upstox/callback
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=
